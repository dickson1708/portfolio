---
import CalendarIcon from "./icons/CalendarIcon.astro";
import MapIcon from "./icons/MapIcon.astro";
import SchoolIcon from "./icons/SchoolIcon.astro";

const { estudio, centro, fechas, diplomaUrl } = Astro.props;
---

<div class="mt-5">
    <div
        class="relative overflow-hidden flex flex-col justify-center items-center m-auto max-w-xl rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm hover:border-[#CBACF9]/50 transition-all duration-300"
    >
        <!-- Barra lateral -->
        <div class="absolute left-0 top-0 h-full w-1 bg-[#CBACF9]"></div>

        <!-- Glow decorativo -->
        <div
            class="absolute -left-10 top-1/2 h-24 w-24 -translate-y-1/2 rounded-full bg-[#CBACF9]/10 blur-3xl"
        >
        </div>

        <span class="flex justify-center items-center gap-2 py-2">
            <SchoolIcon />
            <h3 class="text-xl font-semibold text-center">
                {estudio}
            </h3>
        </span>

        <span class="flex justify-center items-center gap-2 py-2">
            <MapIcon />
            <p class="text-gray-400 text-center">
                {centro}
            </p>
        </span>

        <span class="flex justify-center items-center gap-2 py-2">
            <CalendarIcon />
            <p class="text-md text-[#CBACF9] text-center">
                {fechas}
            </p>
        </span>

        {
            diplomaUrl && (
                <a
                    href={diplomaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-6 inline-flex items-center gap-2 rounded-lg border border-[#CBACF9]/30 px-4 py-2 text-sm font-medium text-[#CBACF9] transition-all duration-300 hover:bg-[#CBACF9] hover:text-black"
                >
                    View Diploma
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M7 17L17 7M17 7H8M17 7V16"
                        />
                    </svg>
                </a>
            )
        }
    </div>
</div>
