---
interface Props {
     homeText: string;
     aboutText: string;
     projectsText: string;
     educationText: string;
     contactText: string;
     currentLang: "en" | "es";
}

const {
     homeText,
     aboutText,
     projectsText,
     educationText,
     contactText,
     currentLang,
} = Astro.props;
---

<header class="pt-6">
     <nav
          class="fixed top-6 left-1/2 -translate-x-1/2 z-50
               px-8 py-3
               rounded-full
               bg-[#141428]/80
               backdrop-blur-md
               border border-[#CBACF9]/20
               shadow-lg shadow-black/30"
     >
          <ul class="flex items-center gap-8 text-sm md:text-base font-medium">
               <li>
                    <a
                         href="#home"
                         class="relative text-[#CBACF9] hover:text-white transition-colors duration-300
                           after:absolute after:left-1/2 after:-translate-x-1/2 after:bottom-[-8px]
                           after:h-[2px] after:w-0 after:bg-[#CBACF9]
                           after:transition-all after:duration-300
                           hover:after:w-5"
                         >{homeText}</a
                    >
               </li>
               <li>
                    <a
                         href="#about"
                         class="relative text-[#CBACF9] hover:text-white transition-colors duration-300
                           after:absolute after:left-1/2 after:-translate-x-1/2 after:bottom-[-8px]
                           after:h-[2px] after:w-0 after:bg-[#CBACF9]
                           after:transition-all after:duration-300
                           hover:after:w-5"
                         >{aboutText}</a
                    >
               </li>
               <li>
                    <a
                         href="#projects"
                         class="relative text-[#CBACF9] hover:text-white transition-colors duration-300
                           after:absolute after:left-1/2 after:-translate-x-1/2 after:bottom-[-8px]
                           after:h-[2px] after:w-0 after:bg-[#CBACF9]
                           after:transition-all after:duration-300
                           hover:after:w-5"
                         >{projectsText}</a
                    >
               </li>
               <li>
                    <a
                         href="#education"
                         class="relative text-[#CBACF9] hover:text-white transition-colors duration-300
                           after:absolute after:left-1/2 after:-translate-x-1/2 after:bottom-[-8px]
                           after:h-[2px] after:w-0 after:bg-[#CBACF9]
                           after:transition-all after:duration-300
                           hover:after:w-5"
                         >{educationText}</a
                    >
               </li>
               <li>
                    <a
                         href="#contact"
                         class="relative text-[#CBACF9] hover:text-white transition-colors duration-300
                           after:absolute after:left-1/2 after:-translate-x-1/2 after:bottom-[-8px]
                           after:h-[2px] after:w-0 after:bg-[#CBACF9]
                           after:transition-all after:duration-300
                           hover:after:w-5"
                         >{contactText}</a
                    >
               </li>
               <li>
                    <div class="w-px h-5 bg-[#CBACF9]/30"></div>
               </li>
               <li>
                    <!-- SELECTOR DE IDIOMA -->
                    <div class="flex items-center gap-2">
                         <a
                              href="/"
                              class={`px-2 py-1 rounded-md transition ${
                                   currentLang === "en"
                                        ? "bg-[#CBACF9] text-black"
                                        : "text-[#CBACF9] hover:text-white"
                              }`}
                         >
                              🇬🇧 EN
                         </a>

                         <span class="text-white/20">|</span>

                         <a
                              href="/es"
                              class={`px-2 py-1 rounded-md transition ${
                                   currentLang === "es"
                                        ? "bg-[#CBACF9] text-black"
                                        : "text-[#CBACF9] hover:text-white"
                              }`}
                         >
                              🇪🇸 ES
                         </a>
                    </div>
               </li>
          </ul>
     </nav>
</header>
