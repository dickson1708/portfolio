---
import { Image } from "astro:assets";
import ProjectCard from "../../components/ProjectCard.astro";
import ArrowRightIcon from "../../components/icons/ArrowRightIcon.astro";
import Tooltip from "../../components/Tooltip.astro";
import Layout from "../../layouts/Layout.astro";
import Carousel from "../../components/Carousel.astro";
import MaiIcon from "../../components/icons/MaiIcon.astro";
import CardIcon from "../../components/icons/CardIcon.astro";
import LinkedinIcon from "../../components/icons/LinkedinIcon.astro";
import GithubIcon from "../../components/icons/GithubIcon.astro";
import EducationCard from "../../components/EducationCard.astro";
import DownloadIcon from "../../components/icons/DownloadIcon.astro";
import Navbar from "../../components/Navbar.astro";
---

<Layout>
    <main>
        <Navbar
            homeText="Inicio"
            aboutText="Acerca de mí"
            projectsText="Proyectos"
            educationText="Educación"
            contactText="Contacto"
        />
        <section id="home" class="scroll-mt-40">
            <div
                class="mt-50 py-15 px-20 max-w-8xl mx-auto
           grid md:grid-cols-2 gap-10 items-center"
            >
                <div data-aos="fade-right">
                    <h1
                        class="text-4xl lg:text-6xl font-extrabold leading-tight"
                    >
                        👋🏻 Hola, soy <span class="text-[#CBACF9]">Dickson</span>
                    </h1>

                    <p class="mt-2 text-2xl lg:text-3xl text-yellow-100">
                        Desarrollador Full-Stack 🇪🇸
                    </p>

                    <h2
                        class="mt-4 text-xl lg:text-3xl font-semibold text-[#CBACF9]"
                    >
                        Construyendo Aplicaciones Seguras y Escalables
                    </h2>

                    <p class="mt-2 text-lg text-gray-300 max-w-2xl">
                        Especializado en Angular y Spring Boot, creando
                        aplicaciones web robustas.
                    </p>
                    <div class="flex mt-8 gap-4">
                        <a
                            href="mailto:dickson17081999@gmail.com"
                            target="_blank"
                            data-aos="fade-up"
                            data-aos-delay="100"
                            class="p-3 rounded-full
           bg-white/5
           border border-white/10
           text-gray-300
           hover:text-[#CBACF9]
           hover:bg-white/20
           hover:-translate-y-1
           hover:shadow-[0_0_15px_rgba(203,172,249,0.25)]
           transition-all duration-300"
                        >
                            <CardIcon />
                        </a>
                        <a
                            href="https://es.linkedin.com/in/dicksoncelauropena"
                            target="_blank"
                            data-aos="fade-up"
                            data-aos-delay="200"
                            class="p-3 rounded-full
           bg-white/5
           border border-white/10
           text-gray-300
           hover:text-[#CBACF9]
           hover:bg-white/20
           hover:-translate-y-1
           hover:shadow-[0_0_15px_rgba(203,172,249,0.25)]
           transition-all duration-300"
                        >
                            <LinkedinIcon />
                        </a>
                        <a
                            href="https://github.com/dickson1708"
                            target="_blank"
                            data-aos="fade-up"
                            data-aos-delay="300"
                            class="p-3 rounded-full
           bg-white/5
           border border-white/10
           text-gray-300
           hover:text-[#CBACF9]
           hover:bg-white/20
           hover:-translate-y-1
           hover:shadow-[0_0_15px_rgba(203,172,249,0.25)]
           transition-all duration-300"
                        >
                            <GithubIcon />
                        </a>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row gap-4"
                        data-aos="fade-up"
                        data-aos-delay="400"
                    >
                        <!-- CTA principal -->
                        <a href="#projects" class="glow-button">
                            <span class="glow-content">
                                Ver mi trabajo
                                <ArrowRightIcon />
                            </span>
                            <span class="glow-overlay"></span>
                        </a>

                        <!-- CTA secundario -->
                        <a href="/cv.pdf" download class="cv-button">
                            <span class="flex items-center gap-1">
                                Descargar CV
                                <DownloadIcon />
                            </span>
                        </a>
                    </div>
                </div>

                <div class="flex justify-center" data-aos="fade-left">
                    <Image
                        src="/assets/logo_portfolio.png"
                        alt="Memoji de Dickson Celauro"
                        loading="eager"
                        width={900}
                        height={900}
                    />
                </div>
            </div>
        </section>

        <section id="skills" class="py-15">
            <div
                class="text-center text-4xl lg:text-5xl font-bold"
                data-aos="fade-down"
            >
                <h2>Mi <span class="text-[#CBACF9]">Stack</span></h2>
            </div>
            <div
                class="flex flex-wrap justify-center items-center gap-6 bg-gray-800 p-10 mt-10 max-w-4xl mx-auto rounded-2xl shadow-xl"
                data-aos="zoom-in"
            >
                <img
                    data-tooltip-target="angular-tooltip"
                    src="/assets/skills/angular.png"
                    alt="angular"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="50"
                />
                <Tooltip id="angular-tooltip" content="Angular" />
                <img
                    data-tooltip-target="spring-tooltip"
                    src="/assets/skills/springboot.png"
                    alt="springboot"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="100"
                />
                <Tooltip id="spring-tooltip" content="Springboot" />
                <img
                    data-tooltip-target="java-tooltip"
                    src="/assets/skills/java.png"
                    alt="java"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="150"
                />
                <Tooltip id="java-tooltip" content="Java" />
                <img
                    data-tooltip-target="ts-tooltip"
                    src="/assets/skills/typescript.png"
                    alt="typescript"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="200"
                />
                <Tooltip id="ts-tooltip" content="Typescript" />
                <img
                    data-tooltip-target="js-tooltip"
                    src="/assets/skills/javascript.png"
                    alt="javascript"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="250"
                />
                <Tooltip id="js-tooltip" content="Javascript" />
                <img
                    data-tooltip-target="html-tooltip"
                    src="/assets/skills/html.png"
                    alt="html"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="300"
                />
                <Tooltip id="html-tooltip" content="HTML" />
                <img
                    data-tooltip-target="css-tooltip"
                    src="/assets/skills/css-3.png"
                    alt="css"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="350"
                />
                <Tooltip id="css-tooltip" content="CSS" />
                <img
                    data-tooltip-target="sass-tooltip"
                    src="/assets/skills/sass.png"
                    alt="sass"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="400"
                />
                <Tooltip id="sass-tooltip" content="SASS" />
                <img
                    data-tooltip-target="tailwind-tooltip"
                    src="/assets/skills/tailwindCss.png"
                    alt="tailwindCss"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="450"
                />
                <Tooltip id="tailwind-tooltip" content="Tailwind CSS" />
                <img
                    data-tooltip-target="bootstrap-tooltip"
                    src="/assets/skills/bootstrap.png"
                    alt="bootstrap"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="500"
                />
                <Tooltip id="bootstrap-tooltip" content="Bootstrap" />
                <img
                    data-tooltip-target="astro-tooltip"
                    src="/assets/skills/astro.png"
                    alt="astro"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="550"
                />
                <Tooltip id="astro-tooltip" content="Astro" />
                <img
                    data-tooltip-target="jhipster-tooltip"
                    src="/assets/skills/jhipster.png"
                    alt="jhipster"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="600"
                />
                <Tooltip id="jhipster-tooltip" content="JHipster" />
                <img
                    data-tooltip-target="mysql-tooltip"
                    src="/assets/skills/mysql.png"
                    alt="mysql"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="650"
                />
                <Tooltip id="mysql-tooltip" content="MySQL" />
                <img
                    data-tooltip-target="postgresql-tooltip"
                    src="/assets/skills/postgresql.png"
                    alt="postgresql"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="700"
                />
                <Tooltip id="postgresql-tooltip" content="PostgreSQL" />
                <img
                    data-tooltip-target="git-tooltip"
                    src="/assets/skills/git.png"
                    alt="git"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="750"
                />
                <Tooltip id="git-tooltip" content="Git" />
                <img
                    data-tooltip-target="github-tooltip"
                    src="/assets/skills/github.png"
                    alt="github"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="800"
                />
                <Tooltip id="github-tooltip" content="Github" />
                <img
                    data-tooltip-target="bitbucket-tooltip"
                    src="/assets/skills/bitbucket.webp"
                    alt="bitbucket"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="850"
                />
                <Tooltip id="bitbucket-tooltip" content="Bitbucket" />
                <img
                    data-tooltip-target="jira-tooltip"
                    src="/assets/skills/jira.png"
                    alt="jira"
                    width="60"
                    data-aos="zoom-in"
                    data-aos-delay="900"
                />
                <Tooltip id="jira-tooltip" content="Jira" />
                <img
                    data-tooltip-target="sourcetree-tooltip"
                    src="/assets/skills/sourcetree.webp"
                    alt="sourcetree"
                    width="80"
                    data-aos="zoom-in"
                    data-aos-delay="950"
                />
                <Tooltip id="sourcetree-tooltip" content="Sourcetree" />
            </div>
        </section>

        <section id="about" class="py-15">
            <div
                class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center"
            >
                <div data-aos="fade-right">
                    <h2 class="text-4xl lg:text-5xl font-bold">
                        Acerca <span class="text-[#CBACF9]">de Mí</span>
                    </h2>

                    <p class="mt-6 text-gray-300">
                        Soy un Desarrollador de Software Web con un fuerte
                        enfoque en las tecnologías Angular y Spring Boot,
                        dedicado a construir aplicaciones web seguras,
                        escalables y fáciles de mantener.
                    </p>

                    <p class="mt-4 text-gray-300">
                        Tras graduarme en el Grado Superior de Desarrollo de
                        Aplicaciones Web, continué potenciando mis habilidades a
                        través de formación avanzada y programas especializados
                        en desarrollo frontend y backend moderno. Mi experiencia
                        abarca el ciclo completo de desarrollo de software,
                        desde el diseño de interfaces de usuario adaptables
                        hasta la implementación de lógica de negocio, APIs y
                        soluciones de bases de datos.
                    </p>

                    <p class="mt-4 text-gray-300">
                        Apasionado por la tecnología y el aprendizaje continuo,
                        me esfuerzo por crear software de alta calidad que
                        combine rendimiento, usabilidad y mantenibilidad a largo
                        plazo.
                    </p>
                </div>

                <div data-aos="fade-left" data-aos-delay="200">
                    <Image
                        src="/assets/portatil.png"
                        alt="About me"
                        width={500}
                        height={500}
                    />
                </div>

                <div
                    class="md:col-span-2 text-center mt-4"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <p
                        class="text-lg uppercase tracking-[0.3em] text-[#CBACF9]"
                    >
                        Soluciones Full-Stack
                    </p>

                    <h3 class="mt-2 text-lg font-semibold text-white">
                        Cómo transformo ideas en software
                    </h3>
                </div>

                <div class="md:col-span-2 grid md:grid-cols-2 gap-4">
                    <div
                        class="rounded-xl bg-[#141428] border border-white/10 p-8"
                        data-aos="zoom-in-up"
                        data-aos-delay="100"
                    >
                        <h3 class="font-bold text-white text-center text-lg">
                            Desarrollo Frontend
                        </h3>
                        <div
                            class="flex items-center gap-4 text-gray-300 text-sm"
                        >
                            <img
                                src="/assets/skills/interfaz.apng.png"
                                alt="Frontend"
                                class="w-12"
                            />
                            <strong>
                                Creación de interfaces de usuario modernas, responsivas y reutilizables.
                            </strong>
                        </div>
                    </div>

                    <div
                        class="rounded-xl bg-[#141428] border border-white/10 p-8"
                        data-aos="zoom-in-up"
                        data-aos-delay="200"
                    >
                        <h3 class="font-bold text-white text-center text-lg">
                            Ingeniería Backend
                        </h3>
                        <div
                            class="flex items-center gap-4 text-gray-300 text-sm"
                        >
                            <img
                                src="/assets/skills/backend.apng.png"
                                alt="Backend"
                                class="w-12"
                            />
                            <strong>
                                Desarrollo de servicios backend seguros, escalables y mantenibles.
                            </strong>
                        </div>
                    </div>

                    <div
                        class="rounded-xl bg-[#141428] border border-white/10 p-8"
                        data-aos="zoom-in-up"
                        data-aos-delay="300"
                    >
                        <h3 class="font-bold text-white text-center text-lg">
                            Diseño de Base de Datos
                        </h3>
                        <div
                            class="flex items-center gap-4 text-gray-300 text-sm"
                        >
                            <img
                                src="/assets/skills/bbdd.apng.png"
                                alt="Database"
                                class="w-12"
                            />
                            <strong>
                                Diseño de bases de datos relacionales eficientes y
                                APIs RESTful.
                            </strong>
                        </div>
                    </div>

                    <div
                        class="rounded-xl bg-[#141428] border border-white/10 p-8"
                        data-aos="zoom-in-up"
                        data-aos-delay="400"
                    >
                        <h3 class="font-bold text-white text-center text-lg">
                            IA & Automatización
                        </h3>
                        <div
                            class="flex items-center gap-4 text-gray-300 text-sm"
                        >
                            <img
                                src="/assets/skills/IA.apng.png"
                                alt="IA"
                                class="w-12"
                            />
                            <strong>
                                Integración de herramientas de Inteligencia Artificial para optimizar procesos y desarrollo.
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="projects" class="py-15 scroll-mt-32">
            <div data-aos="fade-down">
                <h2 class="text-center text-4xl lg:text-5xl font-bold">
                    Proyectos <span class="text-[#CBACF9]">recientes</span>
                </h2>
            </div>
            <div
                class="flex flex-wrap justify-center 2xl:mx-10 gap-10 place-items-center mt-20"
            >
                <ProjectCard
                    data-aos="fade-up"
                    data-aos-delay="100"
                    title="App de Alquiler de Autos"
                    description="Plataforma de alquiler full-stack con autenticación, gestión CRUD, accesos basados en roles y flujo de trabajo para reserva de vehículos."
                    image="/assets/projects/rentalcar_project.png"
                    link="/rental-car-app"
                    skills={[
                        "/assets/skills/angular.png",
                        "/assets/skills/springboot.png",
                        "/assets/skills/typescript.png",
                        "/assets/skills/java.png",
                        "/assets/skills/sass.png",
                        "/assets/skills/bootstrap.png",
                        "/assets/skills/mysql.png",
                    ]}
                    ,
                    githubLink="https://github.com/dickson1708/RentACar",
                    btnCode="Código",
                    btnLiveProject="Ver Proyecto"
                />
                <ProjectCard
                    data-aos="fade-up"
                    data-aos-delay="250"
                    title="App para Gestión de Concesionaria de Autos"
                    description="Una aplicación full-stack para la gestión de concesionarias de autos, construida con JHipster, Angular y Java."
                    image="/assets/projects/dealership_project.png"
                    link="/car-dealership-app"
                    skills={[
                        "/assets/skills/angular.png",
                        "/assets/skills/springboot.png",
                        "/assets/skills/typescript.png",
                        "/assets/skills/java.png",
                        "/assets/skills/sass.png",
                        "/assets/skills/bootstrap.png",
                        "/assets/skills/mysql.png",
                    ]}
                    ,
                    githubLink="https://bitbucket.org/dicksons-personal-projects/dealerapp/commits/branch/develop"
                    ,
                    btnCode="Código"
                    ,
                    btnLiveProject="Ver Proyecto"
                />
                <ProjectCard
                    data-aos="fade-up"
                    data-aos-delay="400"
                    title="Equipo deportivo de Kickingball"
                    description="Aplicación web frontend para un equipo de deporte español, construida con HTML, CSS, JS y Bootstrap."
                    image="/assets/projects/gladiadoras_project.png"
                    link="https://www.gladiadoraskickingball.com/"
                    skills={[
                        "/assets/skills/html.png",
                        "/assets/skills/css-3.png",
                        "/assets/skills/javascript.png",
                    ]}
                    ,
                    githubLink="https://github.com/dickson1708/GladiadorasKickingball"
                    ,
                    btnCode="Código"
                    ,
                    btnLiveProject="Ver Proyecto"
                />
            </div>
        </section>

        <section id="education" class="pt-15 scroll-mt-46">
            <div
                class="text-center text-4xl lg:text-5xl font-bold"
                data-aos="fade-down"
            >
                <h2>Edu<span class="text-[#CBACF9]">cación</span></h2>
            </div>
            <div class="py-10">
                <EducationCard
                    data-aos="fade-right"
                    estudio="Grado Superior en Desarrollo de Aplicaciones Web"
                    centro="Cesur, Madrid"
                    fechas="Sep 2023 - Jun 2025"
                    diplomaUrl="/public/certificates/FP.png"
                    btnViewDiploma="Ver Diploma"
                />
                <EducationCard
                    data-aos="fade-left"
                    estudio="Bachillerato en Ciencias"
                    centro="U.E.P Colegio Belagua, Caracas"
                    fechas="Sep 2011 - Jun 2016"
                    diplomaUrl="/public/certificates/bachillerato.png"
                    btnViewDiploma="Ver Diploma"
                />
            </div>
            <div class="mt-10">
                <Carousel />
            </div>
        </section>

        <section
            id="contact"
            class="bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 text-white"
        >
            <div class="py-15 gap-6 flex flex-col justify-center items-center">
                <h2
                    class="text-center text-5xl font-bold tracking-tight text-[#CBACF9]"
                    data-aos="fade-down"
                >
                    ¡Trabajemos juntos!
                </h2>
                <p
                    class="text-lg text-gray-300"
                    data-aos="fade-up"
                    data-aos-delay="150"
                >
                    ¡Estoy actualmente abierto a nuevas oportunidades — hablemos!
                </p>
                <div
                    class="flex justify-center"
                    data-aos="zoom-in"
                    data-aos-delay="250"
                >
                    <a
                        href="mailto:dickson17081999@gmail.com"
                        class="group flex items-center gap-4 bg-gray-800 border border-[#CBACF9]/30 hover:border-[#CBACF9] hover:bg-[#CBACF9]/10 transition-all rounded-xl p-6 shadow-lg"
                    >
                        <div
                            class="w-8 h-8 flex items-center justify-center text-[#EA4335] group-hover:text-white transition"
                        >
                            <MaiIcon />
                        </div>
                        <span
                            class="text-lg font-medium text-white group-hover:text-[#CBACF9] transition"
                        >
                            dickson17081999@gmail.com
                        </span>
                    </a>
                </div>
                <div
                    class="max-w-3xl mx-auto px-6"
                    data-aos="fade-up"
                    data-aos-delay="350"
                >
                    <div
                        class="rounded-3xl border border-white/10 bg-white/5 backdrop-blur-sm p-8 lg:p-12"
                    >
                        <div class="text-center mb-10">
                            <h2 class="text-4xl font-bold">
                                Contacta <span class="text-[#CBACF9]">conmigo</span>
                            </h2>

                            <p class="mt-4 text-gray-300 max-w-xl mx-auto">
                                ¿Tienes un proyecto en mente o una oportunidad de trabajo? Rellena el formulario de abajo y te contactaré lo antes posible!
                            </p>
                        </div>

                        <form
                            class="space-y-6"
                            action="https://api.web3forms.com/submit"
                            method="POST"
                        >
                            <div>
                                <input
                                    type="hidden"
                                    name="access_key"
                                    value="9459bb1a-5b01-4aa6-8ea6-38355ac480fc"
                                />
                                <label
                                    for="name"
                                    class="block mb-2 text-sm text-gray-300"
                                >
                                    Nombre
                                </label>

                                <input
                                    id="name"
                                    name="name"
                                    type="text"
                                    placeholder="Dickson Celauro"
                                    class="w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white placeholder:text-gray-500 focus:outline-none focus:border-[#CBACF9] focus:ring-2 focus:ring-[#CBACF9]/20 transition"
                                    required
                                />
                            </div>

                            <div>
                                <label
                                    for="email"
                                    class="block mb-2 text-sm text-gray-300"
                                >
                                    Correo Electrónico
                                </label>

                                <input
                                    id="email"
                                    name="email"
                                    type="email"
                                    placeholder="dickson@ejemplo.com"
                                    class="w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white placeholder:text-gray-500 focus:outline-none focus:border-[#CBACF9] focus:ring-2 focus:ring-[#CBACF9]/20 transition"
                                    required
                                />
                            </div>

                            <div>
                                <label
                                    for="message"
                                    class="block mb-2 text-sm text-gray-300"
                                >
                                    Mensaje
                                </label>

                                <textarea
                                    id="message"
                                    rows="6"
                                    placeholder="Dime sobre tu proyecto..."
                                    name="message"
                                    class="w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white placeholder:text-gray-500 focus:outline-none focus:border-[#CBACF9] focus:ring-2 focus:ring-[#CBACF9]/20 transition resize-none"
                                    required></textarea>
                            </div>

                            <button
                                type="submit"
                                class="w-full rounded-xl bg-[#CBACF9] px-6 py-3 font-medium text-black transition hover:scale-[1.02] hover:shadow-lg hover:shadow-[#CBACF9]/20"
                            >
                                Enviar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <style>
        .glow-button {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
            margin-top: 2.5rem;
            padding: 1.25rem 2.5rem;
            max-width: max-content;
            border-radius: 0.5rem;
            background-color: #141428;
            border: 1px solid #4b5563;
            /* gray-700 */
            overflow: hidden;
            transition: border-color 0.3s;
            text-decoration: none;
            color: white;
        }

        .glow-button:hover {
            border-color: #cbacf9;
        }

