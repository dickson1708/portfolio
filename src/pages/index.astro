---
import { Image } from "astro:assets";
import ProjectCard from "../components/ProjectCard.astro";
import ArrowRightIcon from "../components/icons/ArrowRightIcon.astro";
import Tooltip from "../components/Tooltip.astro";
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import MaiIcon from "../components/icons/MaiIcon.astro";
import CardIcon from "../components/icons/CardIcon.astro";
import LinkedinIcon from "../components/icons/LinkedinIcon.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import EducationCard from "../components/EducationCard.astro";
import DownloadIcon from "../components/icons/DownloadIcon.astro";
import Navbar from "../components/Navbar.astro";
import LogoPortfolio from "../assets/logo_portfolio.webp";
import AngularIcon from "../assets/skills/angular.svg";
import SpringIcon from "../assets/skills/spring.svg";
import JavaIcon from "../assets/skills/java.svg";
import TypeScriptIcon from "../assets/skills/typescript.svg";
import JavaScriptIcon from "../assets/skills/javascript.svg";
import HTMLIcon from "../assets/skills/HTML.svg";
import CSSIcon from "../assets/skills/CSS.svg";
import SassIcon from "../assets/skills/sass.svg";
import TailwindIcon from "../assets/skills/tailwind.svg";
import BootstrapIcon from "../assets/skills/bootstrap.svg";
import AstroIcon from "../assets/skills/astro.svg";
import JhipsterIcon from "../assets/skills/jhipster.svg";
import MysqlIcon from "../assets/skills/mysql.svg";
import PostgresqlIcon from "../assets/skills/postgresql.svg";
import GitIcon from "../assets/skills/git.svg";
import GitHubIcon from "../assets/skills/github.svg";
import BitbucketIcon from "../assets/skills/bitbucket.svg";
import JiraIcon from "../assets/skills/jira.svg";
import SourcetreeIcon from "../assets/skills/sourcetree.svg";
import PortatilImage from "../assets/portatil.png";
import CarRentalApp from "../assets/projects/rentalcar_project.webp";
import DealershipApp from "../assets/projects/dealership_project.webp";
import KickingballApp from "../assets/projects/gladiadoras_project.webp";

---

<Layout>
    <main>
        <Navbar
            homeText="Home"
            aboutText="About Me"
            projectsText="Projects"
            educationText="Education"
            contactText="Contact"
            currentLang="en"
        />
        <section id="home" class="scroll-mt-40">
            <div
                class="mt-50 py-15 px-20 max-w-8xl mx-auto
           grid md:grid-cols-2 gap-10 items-center"
            >
                <div data-aos="fade-right">
                    <h1
                        class="text-4xl lg:text-6xl font-extrabold leading-tight"
                    >
                        👋🏻 Hi, I am <span class="text-[#CBACF9]">Dickson</span>
                    </h1>

                    <p class="mt-2 text-2xl lg:text-3xl text-yellow-100">
                        Full-Stack Developer 🇪🇸
                    </p>

                    <h2
                        class="mt-4 text-xl lg:text-3xl font-semibold text-[#CBACF9]"
                    >
                        Building Secure & Scalable Applications
                    </h2>

                    <p class="mt-2 text-lg text-gray-300 max-w-2xl">
                        Specialized in Angular and Spring Boot, crafting robust
                        web applications.
                    </p>
                    <div class="flex mt-8 gap-4">
                        <a
                            href="mailto:dickson17081999@gmail.com"
                            target="_blank"
                            data-aos="fade-up"
                            data-aos-delay="100"
                            class="p-3 rounded-full
           bg-white/5
           border border-white/10
           text-gray-300
           hover:text-[#CBACF9]
           hover:bg-white/20
           hover:-translate-y-1
           hover:shadow-[0_0_15px_rgba(203,172,249,0.25)]
           transition-all duration-300"
                        >
                            <CardIcon />
                        </a>
                        <a
                            href="https://es.linkedin.com/in/dicksoncelauropena"
                            target="_blank"
                            data-aos="fade-up"
                            data-aos-delay="200"
                            class="p-3 rounded-full
           bg-white/5
           border border-white/10
           text-gray-300
           hover:text-[#CBACF9]
           hover:bg-white/20
           hover:-translate-y-1
           hover:shadow-[0_0_15px_rgba(203,172,249,0.25)]
           transition-all duration-300"
                        >
                            <LinkedinIcon />
                        </a>
                        <a
                            href="https://github.com/dickson1708"
                            target="_blank"
                            data-aos="fade-up"
                            data-aos-delay="300"
                            class="p-3 rounded-full
           bg-white/5
           border border-white/10
           text-gray-300
           hover:text-[#CBACF9]
           hover:bg-white/20
           hover:-translate-y-1
           hover:shadow-[0_0_15px_rgba(203,172,249,0.25)]
           transition-all duration-300"
                        >
                            <GithubIcon />
                        </a>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row gap-4"
                        data-aos="fade-up"
                        data-aos-delay="400"
                    >
                        <!-- CTA principal -->
                        <a href="#projects" class="glow-button">
                            <span class="glow-content">
                                See my work
                                <ArrowRightIcon />
                            </span>
                            <span class="glow-overlay"></span>
                        </a>

                        <!-- CTA secundario -->
                        <a href="/cv.pdf" download class="cv-button">
                            <span class="flex items-center gap-1">
                                Download CV
                                <DownloadIcon />
                            </span>
                        </a>
                    </div>
                </div>

                <div class="flex justify-center" data-aos="fade-left">
                    <Image
                        src={LogoPortfolio}
                        alt="Memoji de Dickson Celauro"
                        loading="eager"
                        width={900}
                        height={600}
                        class="w-full h-auto"
                    />
                </div>
            </div>
        </section>

        <section id="skills" class="py-15">
            <div
                class="text-center text-4xl lg:text-5xl font-bold"
                data-aos="fade-down"
            >
                <h2>My <span class="text-[#CBACF9]">Stack</span></h2>
            </div>
            <div
                class="flex flex-wrap justify-center items-center gap-6 bg-gray-800 p-10 mt-10 max-w-4xl mx-auto rounded-2xl shadow-xl"
                data-aos="zoom-in"
            >
                <Image
                    data-tooltip-target="angular-tooltip"
                    src={AngularIcon}
                    alt="angular"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="100"
                />
                <Tooltip id="angular-tooltip" content="Angular" />
                <Image
                    data-tooltip-target="spring-tooltip"
                    src={SpringIcon}
                    alt="spring"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="100"
                />
                <Tooltip id="spring-tooltip" content="Spring" />
                <Image
                    data-tooltip-target="java-tooltip"
                    src={JavaIcon}
                    alt="java"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="150"
                />
                <Tooltip id="java-tooltip" content="Java" />
                <Image
                    data-tooltip-target="ts-tooltip"
                    src={TypeScriptIcon}
                    alt="typescript"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="200"
                />
                <Tooltip id="ts-tooltip" content="Typescript" />
                <Image
                    data-tooltip-target="js-tooltip"
                    src={JavaScriptIcon}
                    alt="javascript"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="250"
                />
                <Tooltip id="js-tooltip" content="Javascript" />
                <Image
                    data-tooltip-target="html-tooltip"
                    src={HTMLIcon}
                    alt="html"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="300"
                />
                <Tooltip id="html-tooltip" content="HTML" />
                <Image
                    data-tooltip-target="css-tooltip"
                    src={CSSIcon}
                    alt="css"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="350"
                />
                <Tooltip id="css-tooltip" content="CSS" />
                <Image
                    data-tooltip-target="sass-tooltip"
                    src={SassIcon}
                    alt="sass"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="400"
                />
                <Tooltip id="sass-tooltip" content="SASS" />
                <Image
                    data-tooltip-target="tailwind-tooltip"
                    src={TailwindIcon}
                    alt="tailwindCss"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="450"
                />
                <Tooltip id="tailwind-tooltip" content="Tailwind CSS" />
                <Image
                    data-tooltip-target="bootstrap-tooltip"
                    src={BootstrapIcon}
                    alt="bootstrap"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="500"
                />
                <Tooltip id="bootstrap-tooltip" content="Bootstrap" />
                <Image
                    data-tooltip-target="astro-tooltip"
                    src={AstroIcon}
                    alt="astro"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="550"
                />
                <Tooltip id="astro-tooltip" content="Astro" />
                <Image
                    data-tooltip-target="jhipster-tooltip"
                    src={JhipsterIcon}
                    alt="jhipster"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="600"
                />
                <Tooltip id="jhipster-tooltip" content="JHipster" />
                <Image
                    data-tooltip-target="mysql-tooltip"
                    src={MysqlIcon}
                    alt="mysql"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="650"
                />
                <Tooltip id="mysql-tooltip" content="MySQL" />
                <Image
                    data-tooltip-target="postgresql-tooltip"
                    src={PostgresqlIcon}
                    alt="postgresql"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="700"
                />
                <Tooltip id="postgresql-tooltip" content="PostgreSQL" />
                <Image
                    data-tooltip-target="git-tooltip"
                    src={GitIcon}
                    alt="git"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="750"
                />
                <Tooltip id="git-tooltip" content="Git" />
                <Image
                    data-tooltip-target="github-tooltip"
                    src={GitHubIcon}
                    alt="github"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="800"
                />
                <Tooltip id="github-tooltip" content="Github" />
                <Image
                    data-tooltip-target="bitbucket-tooltip"
                    src={BitbucketIcon}
                    alt="bitbucket"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="850"
                />
                <Tooltip id="bitbucket-tooltip" content="Bitbucket" />
                <Image
                    data-tooltip-target="jira-tooltip"
                    src={JiraIcon}
                    alt="jira"
                    width="60"
                    height="60"
                    data-aos="zoom-in"
                    data-aos-delay="900"
                />
                <Tooltip id="jira-tooltip" content="Jira" />
                <Image
                    data-tooltip-target="sourcetree-tooltip"
                    src={SourcetreeIcon}
                    alt="sourcetree"
                    width="70"
                    height="70"
                    data-aos="zoom-in"
                    data-aos-delay="950"
                />
                <Tooltip id="sourcetree-tooltip" content="Sourcetree" />
            </div>
        </section>

        <section id="about" class="py-15">
            <div
                class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center"
            >
                <div data-aos="fade-right">
                    <h2 class="text-4xl lg:text-5xl font-bold">
                        About <span class="text-[#CBACF9]">Me</span>
                    </h2>

                    <p class="mt-6 text-gray-300">
                        I'm a Web Software Developer with a strong focus on
                        Angular and Spring Boot technologies, dedicated to
                        building secure, scalable and maintainable web
                        applications.
                    </p>

                    <p class="mt-4 text-gray-300">
                        After graduating with a Higher Degree in Web Application
                        Development, I continued strengthening my skills through
                        advanced training and specialized programs in modern
                        frontend and backend development. My expertise covers
                        the complete software development lifecycle, from
                        designing responsive user interfaces to implementing
                        business logic, APIs and database solutions.
                    </p>

                    <p class="mt-4 text-gray-300">
                        Passionate about technology and continuous learning, I
                        strive to create high-quality software that combines
                        performance, usability and long-term maintainability.
                    </p>
                </div>

                <div data-aos="fade-left" data-aos-delay="200">
                    <Image
                        src={PortatilImage}
                        alt="About me"
                        width={500}
                        height={500}
                    />
                </div>

                <div
                    class="md:col-span-2 text-center mt-4"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <p
                        class="text-lg uppercase tracking-[0.3em] text-[#CBACF9]"
                    >
                        Full-Stack Solutions
                    </p>

                    <h3 class="mt-2 text-lg font-semibold text-white">
                        How I turn ideas into software
                    </h3>
                </div>

                <div class="md:col-span-2 grid md:grid-cols-2 gap-4">
                    <div
                        class="rounded-xl bg-[#141428] border border-white/10 p-8"
                        data-aos="zoom-in-up"
                        data-aos-delay="100"
                    >
                        <h3 class="font-bold text-white text-center text-lg">
                            Frontend Development
                        </h3>
                        <div
                            class="flex items-center gap-4 text-gray-300 text-sm"
                        >
                            <img
                                src="/interfaz.apng.png"
                                alt="Frontend"
                                class="w-12"
                            />
                            <strong>
                                Building modern, responsive and reusable user
                                interfaces.
                            </strong>
                        </div>
                    </div>

                    <div
                        class="rounded-xl bg-[#141428] border border-white/10 p-8"
                        data-aos="zoom-in-up"
                        data-aos-delay="200"
                    >
                        <h3 class="font-bold text-white text-center text-lg">
                            Backend Engineering
                        </h3>
                        <div
                            class="flex items-center gap-4 text-gray-300 text-sm"
                        >
                            <img
                                src="/backend.apng.png"
                                alt="Backend"
                                class="w-12"
                            />
                            <strong>
                                Developing secure, scalable and maintainable
                                backend services.
                            </strong>
                        </div>
                    </div>

                    <div
                        class="rounded-xl bg-[#141428] border border-white/10 p-8"
                        data-aos="zoom-in-up"
                        data-aos-delay="300"
                    >
                        <h3 class="font-bold text-white text-center text-lg">
                            Database Design
                        </h3>
                        <div
                            class="flex items-center gap-4 text-gray-300 text-sm"
                        >
                            <img
                                src="/database.apng.png"
                                alt="Database"
                                class="w-12"
                            />
                            <strong>
                                Designing efficient relational databases and
                                RESTful APIs.
                            </strong>
                        </div>
                    </div>

                    <div
                        class="rounded-xl bg-[#141428] border border-white/10 p-8"
                        data-aos="zoom-in-up"
                        data-aos-delay="400"
                    >
                        <h3 class="font-bold text-white text-center text-lg">
                            AI & Automation
                        </h3>
                        <div
                            class="flex items-center gap-4 text-gray-300 text-sm"
                        >
                            <img
                                src="/IA.apng.png"
                                alt="IA"
                                class="w-12"
                            />
                            <strong>
                                Designing efficient relational databases and
                                RESTful APIs.
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="projects" class="py-15 scroll-mt-32">
            <div data-aos="fade-down">
                <h2 class="text-center text-4xl lg:text-5xl font-bold">
                    Recents <span class="text-[#CBACF9]">projects</span>
                </h2>
            </div>
            <div
                class="flex flex-wrap justify-center 2xl:mx-10 gap-10 place-items-center mt-20"
            >
                <ProjectCard
                    data-aos="fade-up"
                    data-aos-delay="100"
                    title="Car Rental App"
                    description="Full-stack rental platform with authentication, CRUD management, role-based access and vehicle booking workflow."
                    image={CarRentalApp}
                    link="/rental-car-app"
                    skills={[
                        AngularIcon,
                        SpringIcon,
                        TypeScriptIcon,
                        JavaIcon,
                        SassIcon,
                        BootstrapIcon,
                        MysqlIcon,
                    ]}
                    githubLink="https://github.com/dickson1708/RentACar"
                    btnCode="Code"
                    btnLiveProject="Check Live Project"
                />
                <ProjectCard
                    data-aos="fade-up"
                    data-aos-delay="250"
                    title="Car Dealership App"
                    description="A full-stack application for managing car dealerships, built with JHipster, Angular and Java."
                    image={DealershipApp}
                    link="/car-dealership-app"
                    skills={[
                        AngularIcon,
                        SpringIcon,
                        TypeScriptIcon,
                        JavaIcon,
                        SassIcon,
                        BootstrapIcon,
                        MysqlIcon,
                    ]}
                    githubLink="https://bitbucket.org/dicksons-personal-projects/dealerapp/commits/branch/develop"
                    btnCode="Code"
                    btnLiveProject="Check Live Project"
                />
                <ProjectCard
                    data-aos="fade-up"
                    data-aos-delay="400"
                    title="Kickingball Team"
                    description="Frontend web application for a Spanish sport team, built with HTML, CSS, JS and Bootstrap."
                    image={KickingballApp}
                    link="https://www.gladiadoraskickingball.com/"
                    skills={[
                        HTMLIcon,
                        CSSIcon,
                        JavaScriptIcon,
                    ]}
                    githubLink="https://github.com/dickson1708/GladiadorasKickingball"
                    btnCode="Code"
                    btnLiveProject="Check Live Project"
                />
            </div>
        </section>

        <section id="education" class="pt-15 scroll-mt-46">
            <div
                class="text-center text-4xl lg:text-5xl font-bold"
                data-aos="fade-down"
            >
                <h2>Edu<span class="text-[#CBACF9]">cation</span></h2>
            </div>
            <div class="py-10">
                <EducationCard
                    data-aos="fade-right"
                    estudio="Higher Degree in Web Application Development"
                    centro="Cesur, Madrid"
                    fechas="Sep 2023 - Jun 2025"
                    diplomaUrl="/public/certificates/FP.png"
                    btnViewDiploma="View Diploma"
                />
                <EducationCard
                    data-aos="fade-left"
                    estudio="Bachelor of Science"
                    centro="U.E.P Colegio Belagua, Caracas"
                    fechas="Sep 2011 - Jun 2016"
                    diplomaUrl="/public/certificates/bachillerato.png"
                    btnViewDiploma="View Diploma"
                />
            </div>
            <div class="mt-10">
                <Carousel />
            </div>
        </section>

        <section
            id="contact"
            class="bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 text-white"
        >
            <div class="py-15 gap-6 flex flex-col justify-center items-center">
                <h2
                    class="text-center text-5xl font-bold tracking-tight text-[#CBACF9]"
                    data-aos="fade-down"
                >
                    Let’s Work Together
                </h2>
                <p
                    class="text-lg text-gray-300"
                    data-aos="fade-up"
                    data-aos-delay="150"
                >
                    I'm currently open to new opportunities — let's talk!
                </p>
                <div
                    class="flex justify-center"
                    data-aos="zoom-in"
                    data-aos-delay="250"
                >
                    <a
                        href="mailto:dickson17081999@gmail.com"
                        class="group flex items-center gap-4 bg-gray-800 border border-[#CBACF9]/30 hover:border-[#CBACF9] hover:bg-[#CBACF9]/10 transition-all rounded-xl p-6 shadow-lg"
                    >
                        <div
                            class="w-8 h-8 flex items-center justify-center text-[#EA4335] group-hover:text-white transition"
                        >
                            <MaiIcon />
                        </div>
                        <span
                            class="text-lg font-medium text-white group-hover:text-[#CBACF9] transition"
                        >
                            dickson17081999@gmail.com
                        </span>
                    </a>
                </div>
                <div
                    class="max-w-3xl mx-auto px-6"
                    data-aos="fade-up"
                    data-aos-delay="350"
                >
                    <div
                        class="rounded-3xl border border-white/10 bg-white/5 backdrop-blur-sm p-8 lg:p-12"
                    >
                        <div class="text-center mb-10">
                            <h2 class="text-4xl font-bold">
                                Let's <span class="text-[#CBACF9]">Connect</span
                                >
                            </h2>

                            <p class="mt-4 text-gray-300 max-w-xl mx-auto">
                                Have a project in mind or job opportunity? Fill
                                out the form below, and I'll get back to you as
                                soon as possible!
                            </p>
                        </div>

                        <form
                            class="space-y-6"
                            action="https://api.web3forms.com/submit"
                            method="POST"
                        >
                            <div>
                                <input
                                    type="hidden"
                                    name="access_key"
                                    value="9459bb1a-5b01-4aa6-8ea6-38355ac480fc"
                                />
                                <label
                                    for="name"
                                    class="block mb-2 text-sm text-gray-300"
                                >
                                    Name
                                </label>

                                <input
                                    id="name"
                                    name="name"
                                    type="text"
                                    placeholder="Dickson Celauro"
                                    class="w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white placeholder:text-gray-500 focus:outline-none focus:border-[#CBACF9] focus:ring-2 focus:ring-[#CBACF9]/20 transition"
                                    required
                                />
                            </div>

                            <div>
                                <label
                                    for="email"
                                    class="block mb-2 text-sm text-gray-300"
                                >
                                    Email
                                </label>

                                <input
                                    id="email"
                                    name="email"
                                    type="email"
                                    placeholder="dickson@example.com"
                                    class="w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white placeholder:text-gray-500 focus:outline-none focus:border-[#CBACF9] focus:ring-2 focus:ring-[#CBACF9]/20 transition"
                                    required
                                />
                            </div>

                            <div>
                                <label
                                    for="message"
                                    class="block mb-2 text-sm text-gray-300"
                                >
                                    Message
                                </label>

                                <textarea
                                    id="message"
                                    rows="6"
                                    placeholder="Tell me about your project..."
                                    name="message"
                                    class="w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white placeholder:text-gray-500 focus:outline-none focus:border-[#CBACF9] focus:ring-2 focus:ring-[#CBACF9]/20 transition resize-none"
                                    required></textarea>
                            </div>

                            <button
                                type="submit"
                                class="w-full rounded-xl bg-[#CBACF9] px-6 py-3 font-medium text-black transition hover:scale-[1.02] hover:shadow-lg hover:shadow-[#CBACF9]/20"
                            >
                                Send Message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>
